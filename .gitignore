# MRound

# Test fixtures are generated, not committed. See tests/fixtures/README.md.
tests/fixtures/parity_corpus/
tests/fixtures/calibration/

# Vendored reference implementations, kept for reading and never altered
# (MEMORY.md D-001). Every version scanned lives beside the last one, so the
# pattern covers the versions that are not here yet as well as the two that
# are. They are large, they are somebody else's release artifact, and the
# parity harness installs its own copy from the index rather than from these.
/auto-round-*/

# Quantization outputs and evaluation results
/outputs/
/results/
/rtn-*/
/mround-*/
# One parent per comparison, named for the model and the scheme, plus the
# archive older comparisons were moved into. A pattern rather than the two
# fixed names those directories used to have.
/parity-*/
*.safetensors
*.gguf
*.mlpackage/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.python-version

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Hugging Face and MLX caches, if pointed here
.cache/

# macOS
.DS_Store

# The generated public tree. A build output, reproducible from
# export_manifest.toml at any commit, and the public repository is itself the
# record of what was published.
/github/

# Smoke test checkpoints. The quantization output patterns above cover the
# names the harnesses choose; this covers the ones a person types by hand, and
# it exists because one of them reached a commit carrying a 245,000 line
# tokenizer.
/cli-smoke-*/
/smoke-*/
/should-refuse*/

# Files this session could not delete itself, left for you to remove.
/_to_delete/

# Where the desktop app drops files it delivers into a conversation. One copy
# of ci.yml reached a commit from here, which is how this pattern got written.
/Claude outputs/

